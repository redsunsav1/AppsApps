# === Telegram Bot ===
BOT_TOKEN=your_telegram_bot_token_here
WEBHOOK_URL=https://your-domain.amvera.io
APP_URL=https://your-domain.amvera.io
# Telegram ID администратора — сюда приходят алерты и уведомления
ADMIN_TELEGRAM_ID=123456789
# Необязательно: имя бота для пригласительных ссылок (иначе берётся через getMe)
# TELEGRAM_BOT_USERNAME=my_bot

# === Безопасность админки ===
# Секрет для POST /api/make-admin (первичное назначение админа)
ADMIN_SECRET=change_me_long_random_string
# PIN — второй фактор для входа в админку. Не задан — PIN не требуется.
ADMIN_PIN=

# === MAX Messenger ===
MAX_ENABLED=true
MAX_BOT_TOKEN=your_max_bot_token_here
MAX_BOT_USERNAME=id301904538307_bot
MAX_WEBHOOK_URL=https://your-domain.amvera.io
# Optional: 5-256 chars, A-Z/a-z/0-9/_/-
MAX_WEBHOOK_SECRET=your_max_webhook_secret
ADMIN_MAX_ID=your_max_user_id

# === PostgreSQL ===
DATABASE_URL=postgresql://user:password@host:5432/dbname

# === CORS (comma-separated, optional) ===
ALLOWED_ORIGINS=https://your-domain.amvera.io,https://web.telegram.org

# === Email (SMTP отдела продаж: сюда уходят паспорта и документы) ===
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=your_email@yandex.ru
SMTP_PASS=your_app_password
EMAIL_SALES=sales@developer.ru

# === AmoCRM ===
AMOCRM_SUBDOMAIN=your_subdomain
AMOCRM_TOKEN=your_long_lived_access_token
AMOCRM_ATTACH_FILES=true
AMOCRM_FILE_UPLOAD_TIMEOUT_MS=20000

# === Server ===
PORT=8080
PG_POOL_MAX=15
FEED_DEBUG_LOGS=false
FEED_PREBOOKING_TTL_SECONDS=120
FEED_FETCH_TIMEOUT_MS=8000
BOOKING_HOLD_HOURS=72
BOOKING_EXPIRY_CRON=*/15 * * * *
SEED_DEMO_DATA=false
ENABLE_TEST_NOTIFY=false
ALLOW_CLEAR_USERS=false

# === Защита от «усохшего» фида ===
# Синк отменяется, если фид вернул меньше FEED_SHRINK_GUARD_RATIO от квартир в базе
# (при базе от FEED_SHRINK_GUARD_MIN квартир). Отключение: FEED_SHRINK_GUARD=off
FEED_SHRINK_GUARD=on
FEED_SHRINK_GUARD_RATIO=0.5
FEED_SHRINK_GUARD_MIN=10
# Алерт админу после N сбоев синка подряд
FEED_ALERT_AFTER_FAILURES=3
